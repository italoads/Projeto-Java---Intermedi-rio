<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.TarefaController"
            stylesheets="@estilo.css">

    <top>
        <VBox spacing="5" styleClass="header">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="TaskManager" styleClass="titulo"/>
            <Label text="Gerenciador de Tarefas" styleClass="subtitulo"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="tabelaTarefas"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colunaId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="colunaTitulo"
                                 text="Título"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colunaDescricao"
                                 text="Descrição"
                                 prefWidth="350"/>

                    <TableColumn fx:id="colunaConcluida"
                                 text="Concluída"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Nova tarefa"
                        onAction="#novaTarefa"
                        styleClass="botao-principal"/>

                <Button text="Editar"
                        onAction="#editarTarefa"/>

                <Button text="Concluir"
                        onAction="#concluirTarefa"/>

                <Button text="Remover"
                        onAction="#removerTarefa"
                        styleClass="botao-remover"/>

                <Button text="Atualizar"
                        onAction="#carregarTarefas"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>
